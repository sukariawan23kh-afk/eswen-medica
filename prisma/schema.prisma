// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ⚠️ PRODUCTION: change to "postgres" before deploying to Vercel
  // (Vercel uses Postgres; SQLite is for local dev only).
  // Local dev: keep "sqlite" + DATABASE_URL=file:./db/custom.db
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Booking — central appointment record for Eswen Medica + Aesthetic Eswen.
// Status flow: NEW → WAITING_PAYMENT → CONFIRMED → (CHECKED IN → IN TREATMENT → COMPLETED)
//              or → PAYMENT_FAILED / CANCELLED / NO SHOW
model Booking {
  id            String   @id @default(cuid())
  refCode       String   @unique // human-friendly, e.g. ESM-AB12CD
  serviceId     String   // references a service in the catalog (data.ts)
  serviceName   String   // snapshot of service name (EN) for records
  doctorId      String   // references a doctor/beautician in the catalog
  doctorName    String   // snapshot of doctor name
  brand         String   // "medical" | "aesthetic"
  bookingDate   String   // ISO date: YYYY-MM-DD
  bookingTime   String   // HH:mm (24h)
  status        String   @default("WAITING_PAYMENT")
  patientName   String
  patientEmail  String
  patientPhone  String
  patientNotes  String?
  depositAmount Int      @default(0) // in IDR
  paymentMethod String?  // Credit Card | Virtual Account | E-Wallet | QRIS | Bank Transfer
  paymentGateway String? // Midtrans | Xendit | Stripe | Manual
  paymentNote   String?  // admin note when confirming a manual/bank-transfer payment (e.g. bank ref, date received)
  confirmedAt   DateTime? // when an admin manually confirmed the deposit was received
  // Client self-declaration: client clicked "I've Made the Transfer" button on
  // the booking confirmation step. Status STAYS WAITING_PAYMENT (admin must
  // still verify receipt in the clinic account), but the client has signaled
  // that they sent the money. Drives the dynamic "Menunggu Verifikasi" status
  // label (between "Menunggu Pembayaran" and "Confirmed") so the system no
  // longer misleadingly shows "Waiting Payment" after the client has paid.
  clientDeclaredTransfer Boolean  @default(false) // client clicked "I've made the transfer" button
  clientDeclaredAt       DateTime?                 // when client self-declared the transfer
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([doctorId, bookingDate, bookingTime])
  @@index([status])
}

// Article — admin-managed blog content (editable from the admin panel).
// The blog section reads published articles from the DB; falls back to the
// static defaults in data.ts when the table is empty.
//
// BILINGUAL: every text field has an EN + ID variant, mirroring the Service
// model. The admin only inputs the Indonesian version (titleId, excerptId,
// contentId, categoryId); the English (titleEn, excerptEn, contentEn,
// categoryEn) is auto-translated on save via translateIdToEn (MyMemory API).
// The public /api/articles?lang=en|id endpoint returns the matching variant.
model Article {
  id          String   @id @default(cuid())
  titleEn     String
  titleId     String
  slug        String   @unique
  excerptEn   String
  excerptId   String
  contentEn   String?  // markdown body (English)
  contentId   String?  // markdown body (Indonesian — admin input)
  categoryEn  String   @default("Medical")
  categoryId  String   @default("Medical")
  imageUrl    String?
  readTime    String?  // e.g. "6 min read"
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

// SiteConfig — singleton row holding ALL editable website content as a JSON
// blob: logo, brand name/tagline, all UI translations (en+id), contact info,
// social links, theme colors, AI assistant text, SEO metadata. Edited from
// the admin "Site Settings" tab.
model SiteConfig {
  id        String   @id @default("singleton")
  config    String   // JSON string; parsed in code
  updatedAt DateTime @updatedAt
}

// Service — admin-editable service catalog (replaces static data.ts services).
model Service {
  id            String   @id @default(cuid())
  categoryEn    String
  categoryId    String
  nameEn        String
  nameId        String
  descriptionEn String
  descriptionId String
  startingPrice String
  deposit       Int      @default(0)
  icon          String   @default("Stethoscope") // lucide icon name
  image         String   @default("/images/service-medical.png")
  gallery       String?  // JSON array of image URLs (additional photos)
  brand         String   @default("medical")
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published])
}

// SpecialOffer — admin-editable promo cards shown on the public site
// (PromoSection + OfferPopup). Each offer is bilingual (EN + ID), has a
// type (daily/weekly/monthly/onetime), optional badge, image, CTA, and
// active/scheduling fields. Edited from the admin "Offers" tab.
model SpecialOffer {
  id          String   @id @default(cuid())
  titleEn     String
  titleId     String
  descEn      String
  descId      String
  offerType   String   @default("weekly")
  badge       String?
  imageUrl    String?
  ctaTextEn   String?
  ctaTextId   String?
  ctaLink     String?
  active      Boolean  @default(true)
  priority    Int      @default(0)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([active])
}

// Doctor — admin-editable professionals (replaces static data.ts doctors).
model Doctor {
  id          String   @id @default(cuid())
  name        String
  roleEn      String
  roleId      String
  category    String   @default("doctor") // "doctor" | "wellness"
  specialtyEn String
  specialtyId String
  experienceEn String
  experienceId String
  bioEn              String?  // long-form biography (English, auto-translated)
  bioId              String?  // long-form biography (Indonesian — admin input)
  educationEn        String?  // medical school, residencies (English)
  educationId        String?  // medical school, residencies (Indonesian — admin input)
  certificationsEn   String?  // board certifications (English)
  certificationsId   String?  // board certifications (Indonesian — admin input)
  languages   String   @default("EN, ID") // comma-separated
  image       String   @default("/images/doctor-1.png")
  initials    String   @default("XX")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}