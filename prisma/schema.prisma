// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Booking — central appointment record for Eswen Medica + Aesthetic Eswen.
// Status flow: NEW → WAITING_PAYMENT → CONFIRMED → (CHECKED IN → IN TREATMENT → COMPLETED)
//              or → PAYMENT_FAILED / CANCELLED / NO SHOW
model Booking {
  id            String   @id @default(cuid())
  refCode       String   @unique // human-friendly, e.g. ESM-AB12CD
  serviceId     String   // references a service in the catalog (data.ts)
  serviceName   String   // snapshot of service name (EN) for records
  doctorId      String   // references a doctor/beautician in the catalog
  doctorName    String   // snapshot of doctor name
  brand         String   // "medical" | "aesthetic"
  bookingDate   String   // ISO date: YYYY-MM-DD
  bookingTime   String   // HH:mm (24h)
  status        String   @default("WAITING_PAYMENT")
  patientName   String
  patientEmail  String
  patientPhone  String
  patientNotes  String?
  depositAmount Int      @default(0) // in IDR
  paymentMethod String?  // Credit Card | Virtual Account | E-Wallet | QRIS | Bank Transfer
  paymentGateway String? // Midtrans | Xendit | Stripe
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([doctorId, bookingDate, bookingTime])
  @@index([status])
}

// Article — admin-managed blog content (editable from the admin panel).
// The blog section reads published articles from the DB; falls back to the
// static defaults in data.ts when the table is empty.
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String?  // markdown body (for a future detail view)
  category    String   @default("Medical")
  imageUrl    String?
  language    String   @default("en") // "en" | "id"
  readTime    String?  // e.g. "6 min read"
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([language])
}